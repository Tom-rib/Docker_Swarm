###############################################################################
# Variables d'Environnement - Docker Swarm
#
# Ce fichier contient toutes les variables de configuration
# Source avec : source .env
# Ou passez les variables aux scripts : bash script.sh $(cat .env | xargs)
###############################################################################

# ============================================================================
# INFRASTRUCTURE - IPs ET ADRESSES
# ============================================================================

# IP du nœud Manager Swarm
MANAGER_IP=192.168.1.10
MANAGER_HOSTNAME=swarm-manager

# IPs des nœuds Workers
WORKER1_IP=192.168.1.11
WORKER1_HOSTNAME=swarm-worker1

WORKER2_IP=192.168.1.12
WORKER2_HOSTNAME=swarm-worker2

WORKER3_IP=192.168.1.13
WORKER3_HOSTNAME=swarm-worker3

# IP du serveur NFS (Stockage persistant)
NFS_SERVER_IP=192.168.1.20
NFS_SERVER_HOSTNAME=swarm-nfs

# Chemins NFS exportés
NFS_MARIADB_PATH=/export/docker/mariadb
NFS_NGINX_PATH=/export/docker/nginx
NFS_APP_PATH=/export/docker/app
NFS_REGISTRY_PATH=/export/docker/registry

# ============================================================================
# DOCKER SWARM - CONFIGURATION
# ============================================================================

# Nom de la stack
STACK_NAME=swarm-stack

# Réseau Swarm
SWARM_NETWORK=swarm-network
SWARM_SUBNET=10.0.9.0/24

# ============================================================================
# MARIADB - BASE DE DONNÉES
# ============================================================================

# Mot de passe root MySQL
MYSQL_ROOT_PASSWORD=RootPassword123!

# Nom de la base de données par défaut
MYSQL_DATABASE=app_db

# Utilisateur application
MYSQL_USER=appuser
MYSQL_PASSWORD=AppPassword123!

# Port d'exposition
MARIADB_PORT=3306

# Nombre de replicas
MARIADB_REPLICAS=2

# Limites de ressources
MARIADB_CPU_LIMIT=1
MARIADB_MEMORY_LIMIT=1G
MARIADB_CPU_RESERVE=0.5
MARIADB_MEMORY_RESERVE=512M

# ============================================================================
# NGINX - SERVEUR WEB & REVERSE PROXY
# ============================================================================

# Ports d'exposition
NGINX_PORT_HTTP=80
NGINX_PORT_HTTPS=443

# Nombre de replicas
NGINX_REPLICAS=2

# Limites de ressources
NGINX_CPU_LIMIT=0.5
NGINX_MEMORY_LIMIT=256M
NGINX_CPU_RESERVE=0.25
NGINX_MEMORY_RESERVE=128M

# ============================================================================
# PHP-FPM - APPLICATION SERVER
# ============================================================================

# Version PHP
PHP_VERSION=8.2

# Nombre de replicas
PHP_REPLICAS=2

# Limites de ressources
PHP_CPU_LIMIT=0.5
PHP_MEMORY_LIMIT=512M
PHP_CPU_RESERVE=0.25
PHP_MEMORY_RESERVE=256M

# ============================================================================
# DOCKER REGISTRY - REPOSITORY INTERNE
# ============================================================================

# Port d'exposition
REGISTRY_PORT=5000

# Version du registar
REGISTRY_VERSION=2

# Nombre de replicas
REGISTRY_REPLICAS=1

# Limites de ressources
REGISTRY_CPU_LIMIT=0.25
REGISTRY_MEMORY_LIMIT=256M

# ============================================================================
# IMAGES DOCKER
# ============================================================================

# Image MariaDB
MARIADB_IMAGE=mariadb:latest

# Image Nginx
NGINX_IMAGE=nginx:latest

# Image PHP-FPM
PHP_FPM_IMAGE=php:8.2-fpm

# Image Docker Registry
REGISTRY_IMAGE=registry:2

# ============================================================================
# LOGGING ET MONITORING
# ============================================================================

# Niveau de log Nginx
NGINX_LOG_LEVEL=warn

# Niveau de log PHP
PHP_LOG_LEVEL=error

# Rétention des logs (en jours)
LOG_RETENTION=30

# ============================================================================
# CERTIFICATS SSL (Production)
# ============================================================================

# Chemin aux certificats SSL
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Domaine SSL
SSL_DOMAIN=example.com
SSL_DOMAIN_ALT=www.example.com

# ============================================================================
# SÉCURITÉ & TIMEOUTS
# ============================================================================

# Taille max des uploads
MAX_UPLOAD_SIZE=100M

# Timeouts FastCGI (en secondes)
FASTCGI_CONNECT_TIMEOUT=60
FASTCGI_SEND_TIMEOUT=60
FASTCGI_READ_TIMEOUT=60

# Timeouts MySQL (en secondes)
MYSQL_CONNECT_TIMEOUT=10

# ============================================================================
# MÉTRIQUES & ALERTES (Optionnel)
# ============================================================================

# Seuil d'alerte CPU (%)
CPU_ALERT_THRESHOLD=80

# Seuil d'alerte Mémoire (%)
MEMORY_ALERT_THRESHOLD=85

# Seuil d'alerte Disque (%)
DISK_ALERT_THRESHOLD=90

# ============================================================================
# BACKUP & DISASTER RECOVERY
# ============================================================================

# Répertoire des backups
BACKUP_DIR=/backups

# Rétention des backups (en jours)
BACKUP_RETENTION=30

# Fréquence des backups (cron format)
BACKUP_SCHEDULE="0 2 * * *"  # 02:00 chaque jour

# ============================================================================
# DÉVELOPPEMENT
# ============================================================================

# Mode debug (true/false)
DEBUG_MODE=false

# Mode verbeux (true/false)
VERBOSE_MODE=false

# Timezone
TZ=Europe/Paris

# ============================================================================
# RESSOURCES GLOBALES RÉSERVÉES
# ============================================================================

# Total CPU disponible sur les workers (cores)
TOTAL_CPU_AVAILABLE=12

# Total Mémoire disponible sur les workers (GB)
TOTAL_MEMORY_AVAILABLE=32

# Réservation système Debian (%)
SYSTEM_RESERVE_PERCENT=10

###############################################################################
# UTILISATION DE CE FICHIER
###############################################################################

# 1. CHARGER LES VARIABLES :
#    source .env
#
# 2. UTILISER LES VARIABLES DANS LES SCRIPTS :
#    echo "Manager IP: $MANAGER_IP"
#    docker service create --name mariadb \
#      --env MYSQL_ROOT_PASSWORD=$MYSQL_ROOT_PASSWORD ...
#
# 3. ADAPTER LES VALEURS :
#    - Remplacer les IPs par vos adresses réelles
#    - Changer les mots de passe (IMPORTANT !)
#    - Adapter les ressources à votre infrastructure
#
# 4. SÉCURITÉ :
#    - Ne pas committer ce fichier avec les vrais passwords en git
#    - Créer un .env.example avec des values fictives
#    - Utiliser un gestionnaire de secrets (Vault, etc.) en production

###############################################################################
